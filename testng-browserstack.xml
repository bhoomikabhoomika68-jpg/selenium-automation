<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="El Pais Scraper - BrowserStack Parallel Execution" 
       parallel="tests" 
       thread-count="5" 
       verbose="1">
    
    <!-- 
        BrowserStack Parallel Testing Configuration
        5 parallel threads testing across desktop and mobile browsers
        
        Prerequisites:
        1. Sign up for free trial at: https://www.browserstack.com/users/sign_up
        2. Set environment variables:
           - BROWSERSTACK_USERNAME=your_username
           - BROWSERSTACK_ACCESS_KEY=your_access_key
    -->
    
    <!-- Test 1: Windows 10 - Chrome Latest -->
    <test name="Windows 10 - Chrome Latest" preserve-order="true">
        <parameter name="browser" value="chrome"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="os" value="Windows"/>
        <parameter name="osVersion" value="10"/>
        <parameter name="deviceName" value=""/>
        <classes>
            <class name="com.elpais.tests.ElPaisBrowserStackTest"/>
        </classes>
    </test>
    
    <!-- Test 2: Windows 11 - Edge Latest -->
    <test name="Windows 11 - Edge Latest" preserve-order="true">
        <parameter name="browser" value="edge"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="os" value="Windows"/>
        <parameter name="osVersion" value="11"/>
        <parameter name="deviceName" value=""/>
        <classes>
            <class name="com.elpais.tests.ElPaisBrowserStackTest"/>
        </classes>
    </test>
    
    <!-- Test 3: macOS Ventura - Safari Latest -->
    <test name="macOS Ventura - Safari Latest" preserve-order="true">
        <parameter name="browser" value="safari"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="os" value="OS X"/>
        <parameter name="osVersion" value="Ventura"/>
        <parameter name="deviceName" value=""/>
        <classes>
            <class name="com.elpais.tests.ElPaisBrowserStackTest"/>
        </classes>
    </test>
    
    <!-- Test 4: iPhone 14 Pro - iOS 16 -->
    <test name="iPhone 14 Pro - iOS 16" preserve-order="true">
        <parameter name="browser" value=""/>
        <parameter name="browserVersion" value=""/>
        <parameter name="os" value=""/>
        <parameter name="osVersion" value="16"/>
        <parameter name="deviceName" value="iPhone 14 Pro"/>
        <classes>
            <class name="com.elpais.tests.ElPaisBrowserStackTest"/>
        </classes>
    </test>
    
    <!-- Test 5: Samsung Galaxy S23 - Android 13 -->
    <test name="Samsung Galaxy S23 - Android 13" preserve-order="true">
        <parameter name="browser" value=""/>
        <parameter name="browserVersion" value=""/>
        <parameter name="os" value=""/>
        <parameter name="osVersion" value="13.0"/>
        <parameter name="deviceName" value="Samsung Galaxy S23"/>
        <classes>
            <class name="com.elpais.tests.ElPaisBrowserStackTest"/>
        </classes>
    </test>
    
</suite>

